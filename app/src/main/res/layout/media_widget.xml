<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#FFFFFFFF">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Radios Viferor" android:textStyle="bold" android:textSize="15sp" android:maxLines="2" />
    <TextView android:id="@+id/widgetSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin reproducción" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/widgetPrev" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Anterior" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/widgetBack" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_media_rew" android:contentDescription="Retroceder" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/widgetPlay" android:layout_width="52dp" android:layout_height="44dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Reproducir o pausar" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/widgetForward" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_media_ff" android:contentDescription="Avanzar" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/widgetNext" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Siguiente" android:background="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>
