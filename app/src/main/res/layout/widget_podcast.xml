<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="1dp">

    <ImageView
        android:id="@+id/widget_watermark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_launcher_art"
        android:scaleType="centerInside"
        android:alpha="0.24"
        android:contentDescription="" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Radios Viferor"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin reproducción"
            android:textColor="#D8D8D8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/widget_back"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−15"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_play"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/widget_forward"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+30"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_volume_down"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/widget_volume"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/widget_volume_progress"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="15"
                android:progress="8" />

            <Button
                android:id="@+id/widget_volume_up"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_button_background"
                android:backgroundTint="@null"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
