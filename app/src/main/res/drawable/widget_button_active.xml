<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de sección del widget que corresponde a lo que suena (o sonó lo último). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5B6BD8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3F4FB8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#7C8BF0" />
        </shape>
    </item>
</selector>
